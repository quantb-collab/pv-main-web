# Nơi nhận lead từ biểu mẫu khảo sát.
#
# Chưa khai biến này thì `/api/lead` trả 503 và biểu mẫu hiện lỗi kèm địa chỉ
# email để người dùng liên hệ thẳng — CỐ Ý. Trước đây biểu mẫu báo "Đã nhận
# thông tin" mà không gửi đi đâu; thà báo hỏng còn hơn để khách ngồi đợi một
# cuộc gọi không bao giờ tới.
#
# Giá trị là một URL nhận POST JSON. Route không biết và không cần biết phía
# sau là gì, nên mọi lựa chọn đang cân nhắc đều cắm vào đây được:
#   · Zapier / Make          — dán URL webhook của zap
#   · Google Apps Script     — deploy web app, dán URL /exec
#   · HubSpot               — Forms API, hoặc một zap đứng giữa
#   · Salesforce Web-to-Lead — cần một lớp trung gian vì nó nhận form-encoded
#   · Slack                  — incoming webhook, nếu chỉ cần báo có lead mới
#
# Payload gửi đi:
#   { "source": "...", "receivedAt": "<ISO>", "lead": { "name": "...", ... } }
LEAD_WEBHOOK_URL=

# Không bắt buộc. Có khai thì route gắn `Authorization: Bearer <token>`.
LEAD_WEBHOOK_TOKEN=
